#!/usr/bin/env bash
# dayflow shim for the preview sandbox. Sits first on PATH.
# `status --json` returns a canned payload matching the real key set for
# the requested DAYFLOW_STATE; `missing` exits 127 like a real spawn
# failure; every other subcommand passes through to the real binary.
set -u

REAL_BIN="${DAYFLOW_REAL_BIN:-dayflow}"
state="${DAYFLOW_STATE:-recording}"
prev=""
for a in "$@"; do
  if [ "$prev" = "--state" ]; then state="$a"; fi
  prev="$a"
done

if [ "${1:-}" = "status" ]; then
  case "$state" in
    missing) exit 127 ;;
    paused)    paused=true;  cap=paused ;;
    locked)    paused=false; cap=locked ;;
    down|stalled) paused=false; cap=down ;;
    *)         paused=false; cap=recording ;;
  esac
  printf '{"capture_state":"%s","recording":%s,"paused":%s,"configured":true,"installed":true,"version":"dev","model":"gemma3:4b","active_app":"Ghostty","ignored_apps":[],"frames_today":42,"blocks_pending":0,"storage_text":"32 MB","today_minutes":312,"panel_expanded":false,"last_block_end_ts":%s}\n' \
    "$cap" "$([ "$cap" = recording ] && echo true || echo false)" "$paused" "$(date +%s)"
  exit 0
fi

exec "$REAL_BIN" "$@"
